# Copy to .env (never commit .env). Docker Compose reads it automatically.
VCO_VCENTER_PASSWORD=changeme
VCO_VCFOPS_PASSWORD=changeme
VCO_API_TOKEN_MPBUILDER=generate-a-long-random-string
# VCO_MOCK=1   # uncomment to run with built-in sample data

# PowerShell build used in the core-pwsh image (default 7.6.9 LTS)
# PWSH_VERSION=7.6.9
# Mac only: set to 0 if the PowerShell image build fails with "Illegal instruction"
# DOTNET_HWINTRINSIC=0

# --- vCommunity Ask (vco-ask service) ---
# Token for changing Settings / Knowledge sources in the UI and for the /api endpoints.
ASK_API_TOKEN=generate-a-long-random-string
# Where the container reaches Ollama. Default suits Rancher Desktop (moby) and Docker Desktop.
# With the containerd engine (nerdctl) use http://host.lima.internal:11434
# ASK_OLLAMA_URL=http://host.docker.internal:11434
# ASK_CHAT_MODEL=qwen3.8:27b-mlx
# ASK_EMBED_MODEL=nomic-embed-text
# Private Git repositories: put a read-only token here and set "Token env var" to this name on the source.
# ASK_GITHUB_TOKEN=
# Performance page: the token the Ask host agent printed when you installed it (ask/agent/Install-AskAgent.ps1).
# ASK_AGENT_TOKEN=
# Where the container reaches the host agent (default http://host.docker.internal:9101; empty turns it off).
# ASK_AGENT_URL=http://host.docker.internal:9101
