# Copy to .env (never commit .env). Docker Compose reads it automatically.
VCO_VCENTER_PASSWORD=changeme
VCO_VCFOPS_PASSWORD=changeme
VCO_API_TOKEN_MPBUILDER=generate-a-long-random-string
# VCO_MOCK=1   # uncomment to run with built-in sample data

# PowerShell build used in the core-pwsh image (default 7.6.9 LTS)
# PWSH_VERSION=7.6.9
# Mac only: set to 0 if the PowerShell image build fails with "Illegal instruction"
# DOTNET_HWINTRINSIC=0

# --- vCommunity Ask (vco-ask service) ---
# Token for changing Settings / Knowledge sources in the UI and for the /api endpoints.
ASK_API_TOKEN=generate-a-long-random-string
# Where the container reaches Ollama. Default suits Rancher Desktop (moby) and Docker Desktop.
# With the containerd engine (nerdctl) use http://host.lima.internal:11434
# ASK_OLLAMA_URL=http://host.docker.internal:11434
# ASK_CHAT_MODEL=qwen3.8:27b-mlx
# ASK_EMBED_MODEL=nomic-embed-text
# LM Studio next to (or instead of) Ollama. Settings page wins over these. LM Studio's own address
# (127.0.0.1 / localhost) works: inside the container it is sent to host.docker.internal.
# In LM Studio turn on Developer > Serve on Local Network. Its model names start with lmstudio:
# ASK_LMSTUDIO_ENABLED=1
# ASK_LMSTUDIO_URL=http://127.0.0.1:1234
# ASK_OLLAMA_ENABLED=0
# ASK_CHAT_MODEL=lmstudio:google/gemma-4-31b
# Only when LM Studio requires an API token:
# ASK_LMSTUDIO_API_KEY=
# With containerd (nerdctl) set the Mac's name for 127.0.0.1 (default host.docker.internal; off = no change):
# ASK_HOST_ALIAS=host.lima.internal
# Private Git repositories: put a read-only token here and set "Token env var" to this name on the source.
# ASK_GITHUB_TOKEN=
# Performance page: the token the Ask host agent printed when you installed it (ask/agent/Install-AskAgent.ps1).
# ASK_AGENT_TOKEN=
# Where the container reaches the host agent (default http://host.docker.internal:9101; empty turns it off).
# ASK_AGENT_URL=http://host.docker.internal:9101
# X posts source (Knowledge sources, plug-in x-posts): your X API app's Bearer token.
# X_BEARER_TOKEN=

# --- draw.io MCP server (drawio-mcp service) ---
# DRAWIO_MCP_IMAGE=jgraph/drawio-mcp:latest
# DRAWIO_MCP_PORT=3001

# --- draw.io editor (drawio service) ---
# DRAWIO_IMAGE=jgraph/drawio:latest
# DRAWIO_PORT=8082
# Where Ask's "Open in draw.io" links go (the address your browser opens). Empty = app.diagrams.net.
# Change it with DRAWIO_PORT, or when you open Ask from another computer.
# ASK_DRAWIO_URL=http://localhost:8082
# Where diagrams open from answers: editor (the web editor above) or desktop (draw.io Desktop on the
# Mac through the host agent 0.4.0+, else a .drawio download). The MCP tools page wins.
# ASK_DRAWIO_OPEN=editor
